# MicroBin on Railway — environment variables
# Copy to .env only for local reference; Railway sets these from the
# deploy form / service variables. Do NOT put real secrets in this file.

# Admin password for /auth_admin (username is admin). Generated per
# deploy by the template (${{secret(16)}}); the upstream default
# password is never used.
MICROBIN_ADMIN_PASSWORD=your-generated-admin-password

# Everything below is set by the wrapper image or the entrypoint;
# listed here so a self-hoster knows what the deploy already does.
# MICROBIN_DATA_DIR=/data
# MICROBIN_ADMIN_USERNAME=admin
# MICROBIN_DISABLE_TELEMETRY=true
# MICROBIN_DISABLE_UPDATE_CHECKING=true
# MICROBIN_PORT is derived from Railway's PORT at boot.
# MICROBIN_PUBLIC_PATH is derived from RAILWAY_PUBLIC_DOMAIN at boot.
